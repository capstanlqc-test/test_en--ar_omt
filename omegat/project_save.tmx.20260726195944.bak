  <body>
    <tu>
      <tuv xml:lang="en">
        <seg>This is a &lt;g1&gt;bolded&lt;/g1&gt; word.</seg>
      </tuv>
      <tuv xml:lang="ar">
        <seg>هذه كلمة بخط &lt;g1&gt;عريض&lt;/g1&gt;.</seg>
      </tuv>
      <note>0.779</note>
    </tu>
    <tu>
      <tuv xml:lang="en">
        <seg>This is my best sentence yet.</seg>
      </tuv>
      <tuv xml:lang="ar">
        <seg>هذه أفضل جملة لي حتى الآن.</seg>
      </tuv>
      <note>0.831</note>
    </tu>
    <tu>
      <tuv xml:lang="en">
        <seg>This is a repeated sentence.</seg>
      </tuv>
      <tuv xml:lang="ar">
        <seg>هذه جملة مكررة.</seg>
      </tuv>
      <note>0.825</note>
    </tu>
    <tu>
      <tuv xml:lang="en">
        <seg>The following is addressed to a girl:</seg>
      </tuv>
      <tuv xml:lang="ar">
        <seg>ما يلي موجه إلى فتاة:</seg>
      </tuv>
      <note>0.83</note>
    </tu>
    <tu>
      <tuv xml:lang="en">
        <seg>What is your age?</seg>
      </tuv>
      <tuv xml:lang="ar">
        <seg>كم عمرك؟</seg>
      </tuv>
      <note>0.835</note>
    </tu>
  </body>
